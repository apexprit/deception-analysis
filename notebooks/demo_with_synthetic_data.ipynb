        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 3. Synthetic Data Generation"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Initialize synthetic data generator\n",
                "generator = SyntheticDataGenerator(config, seed=42)\n",
                "\n",
                "# Generate a small sample of truthful and deceptive features\n",
                "print(\"Generating synthetic data samples...\")\n",
                "truthful_features = generator.generate_fused_features(n_samples=50, label=0)\n",
                "deceptive_features = generator.generate_fused_features(n_samples=50, label=1)\n",
                "\n",
                "print(f\"Truthful samples: {len(truthful_features)} with {len(truthful_features.columns)} features\")\n",
                "print(f\"Deceptive samples: {len(deceptive_features)} with {len(deceptive_features.columns)} features\")\n",
                "print(\"\\nFeature categories:\")\n",
                "print(f\"  Facial: {len(generator.FACIAL_FEATURES)} features\")\n",
                "print(f\"  Audio: {len(generator.AUDIO_FEATURES)} features\")\n",
                "print(f\"  Cross-modal: {len(generator.CROSS_MODAL_FEATURES)} features\")\n",
                "\n",
                "# Show sample features\n",
                "print(\"\\nSample facial features (first 5):\")\n",
                "print(truthful_features[generator.FACIAL_FEATURES[:5]].head())"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 4. Visualize Feature Distributions"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Compare key deception indicators\n",
                "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
                "\n",
                "# Select key features for visualization\n",
                "key_features = [\n",
                "    'eye_left_openness',  # Less eye openness in deception\n",
                "    'pitch_std',          # Higher pitch variation in deception\n",
                "    'pause_count',        # More pauses in deception\n",
                "    'brow_tension',       # Higher brow tension in deception\n",
                "    'mouth_asymmetry',    # More mouth asymmetry in deception\n",
                "    'audio_visual_sync'   # Less audio-visual sync in deception\n",
                "]\n",
                "\n",
                "for idx, feature in enumerate(key_features):\n",
                "    ax = axes[idx // 3, idx % 3]\n",
                "    \n",
                "    # Get data\n",
                "    truthful_vals = truthful_features[feature].values\n",
                "    deceptive_vals = deceptive_features[feature].values\n",
                "    \n",
                "    # Plot distributions\n",
                "    ax.hist(truthful_vals, alpha=0.6, bins=20, label='Truthful', color='green', density=True)\n",
                "    ax.hist(deceptive_vals, alpha=0.6, bins=20, label='Deceptive', color='red', density=True)\n",
                "    \n",
                "    ax.set_title(feature.replace('_', ' ').title())\n",
                "    ax.set_xlabel('Value')\n",
                "    ax.set_ylabel('Density')\n",
                "    ax.legend()\n",
                "    \n",
                "    # Add mean lines\n",
                "    ax.axvline(np.mean(truthful_vals), color='green', linestyle='--', alpha=0.8)\n",
                "    ax.axvline(np.mean(deceptive_vals), color='red', linestyle='--', alpha=0.8)\n",
                "\n",
                "plt.suptitle('Deception Indicators: Truthful vs. Deceptive Feature Distributions', fontsize=14, y=1.02)\n",
                "plt.tight_layout()\n",
                "plt.show()"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 5. Generate Complete Dataset for Training"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Generate a complete balanced dataset\n",
                "print(\"Generating complete training dataset...\")\n",
                "features, labels, subject_ids = generator.generate_dataset(\n",
                "    n_truthful=300,\n",
                "    n_deceptive=300\n",
                ")\n",
                "\n",
                "print(f\"Dataset generated: {len(features)} total samples\")\n",
                "print(f\"  Truthful: {np.sum(labels == 0)} samples\")\n",
                "print(f\"  Deceptive: {np.sum(labels == 1)} samples\")\n",
                "print(f\"  Unique subjects: {len(set(subject_ids))}\")\n",
                "print(f\"  Total features: {len(features.columns)}\")\n",
                "\n",
                "# Save dataset for later use\n",
                "import os\n",
                "os.makedirs('../data/synthetic', exist_ok=True)\n",
                "\n",
                "features.to_csv('../data/synthetic/synthetic_features.csv', index=False)\n",
                "pd.DataFrame({'label': labels, 'subject_id': subject_ids}).to_csv('../data/synthetic/synthetic_labels.csv', index=False)\n",
                "\n",
                "print(\"\\n✅ Dataset saved to ../data/synthetic/\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 6. Train Deception Classifier"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Initialize classifier\n",
                "classifier = DeceptionClassifier(config.model)\n",
                "\n",
                "# Split data for training\n",
                "from sklearn.model_selection import train_test_split\n",
                "\n",
                "X_train, X_test, y_train, y_test = train_test_split(\n",
                "    features, labels, test_size=0.2, random_state=42, stratify=labels\n",
                ")\n",
                "\n",
                "print(f\"Training set: {len(X_train)} samples\")\n",
                "print(f\"Test set: {len(X_test)} samples\")\n",
                "\n",
                "# Train classifier\n",
                "print(\"\\nTraining classifier...\")\n",
                "train_result = classifier.train(X_train, y_train)\n",
                "\n",
                "print(f\"Training accuracy: {train_result['accuracy']:.3f}\")\n",
                "print(f\"Training F1 score: {train_result['f1']:.3f}\")\n",
                "print(f\"Training AUC-ROC: {train_result.get('auc_roc', 'N/A')}\")\n",
                "\n",
                "# Test classifier\n",
                "y_pred = classifier.predict(X_test)\n",
                "y_prob = classifier.predict_proba(X_test)[:, 1]  # Probability of deception\n",
                "\n",
                "# Evaluate\n",
                "from sklearn.metrics import accuracy_score, classification_report\n",
                "\n",
                "test_accuracy = accuracy_score(y_test, y_pred)\n",
                "print(f\"\\nTest accuracy: {test_accuracy:.3f}\")\n",
                "print(\"\\nClassification Report:\")\n",
                "print(classification_report(y_test, y_pred, target_names=['Truthful', 'Deceptive']))"
            ]
        },
