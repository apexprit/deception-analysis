            "metadata": {},
            "source": [
                "## 2. Configuration"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": null,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Create default configuration\n",
                "config = AppConfig()\n",
                "\n",
                "# Display configuration\n",
                "print(\"Project Configuration:\")\n",
                "print(f\"  Data directory: {config.project.data_dir}\")\n",
                "print(f\"  Feature FPS: {config.feature.fps}\")\n",
                "print(f\"  Audio sample rate: {config.audio.sample_rate}\")\n",
                "print(f\"  Model type: {config.model.model_type}\")\n",
