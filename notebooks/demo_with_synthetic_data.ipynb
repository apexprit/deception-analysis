            "metadata": {},
            "outputs": [],
            "source": [
                "# Initialize cross-validator\n",
                "cv = CrossValidator()\n",
                "\n",
                "# Run stratified k-fold cross-validation\n",
                "print(\"Running 5-fold cross-validation...\")\n",
                "cv_results = cv.run_cross_validation(\n",
                "    classifier=DeceptionClassifier,  # Pass class, not instance\n",
                "    X=features,\n",
                "    y=labels,\n",
                "    n_splits=5,\n",
                "    method='stratified'\n",
                ")\n",
                "\n",
                "print(f\"\\nCross-Validation Results (mean ± std across 5 folds):\")\n",
                "for metric, values in cv_results['mean_metrics'].items():\n",
                "    if metric in cv_results['std_metrics']:\n",
                "        std = cv_results['std_metrics'][metric]\n",
                "        print(f\"  {metric}: {values:.3f} ± {std:.3f}\")"
            ]
        },
